{
  "name": "@steno/tau",
  "version": "0.1.0-rc.1",
  "exports": {
    ".": "./mod.ts",
    "./expression": "./src/tau_expr.ts",
    "./parser": "./src/tau_parser.ts"
  },
  "license": "MIT",
  "publish": {
    "include": ["mod.ts", "src/**/*.ts", "README.md", "LICENSE.txt"],
    "exclude": ["**/*_test.ts"]
  },
  "imports": { "@std/assert": "jsr:@std/assert@1.0.19" },
  "tasks": {
    "test": "deno test --allow-read --allow-run tests",
    "fmt:check": "deno x prettier --check .",
    "check": "deno task fmt:check && deno check mod.ts && deno doc --lint mod.ts && deno lint && deno task test"
  },
  "fmt": { "lineWidth": 100 }
}
